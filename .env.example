# 内网模型配置
QWEN_VL_BASE_URL=http://qwen-vl.internal:8000/v1
QWEN_VL_API_KEY=your-api-key-here
VISION_MODEL=qwen3.5-vl-72b-instruct

GLM_BASE_URL=http://glm.internal:8001/v1
GLM_API_KEY=your-api-key-here
CODE_MODEL=glm-5.3

# 校验配置
VISUAL_SIMILARITY_THRESHOLD=85.0
MIN_CONTENT_SIMILARITY=60.0
MIN_EDGE_SIMILARITY=40.0
MAX_RETRY_COUNT=3

# 默认选项
DEFAULT_FRAMEWORK=react
DEFAULT_STYLE_FRAMEWORK=tailwind
DEFAULT_COMPONENT_LIBRARY=antd

# direct: one multimodal call; structured: optional JSON expert pipeline
DEFAULT_PIPELINE=direct
# fast: no auto repair; balanced: bounded repair; precision: more repair budget
QUALITY_MODE=balanced

# Multi-user HTTP server
# Required for pnpm serve / Docker. Use a unique long random secret per user.
API_KEYS=alice:replace-with-a-long-random-secret,bob:replace-with-another-secret
HOST=0.0.0.0
PORT=3000
DATA_DIR=data
MAX_UPLOAD_MB=10
JOB_CONCURRENCY=2
MAX_QUEUE_SIZE=100
RATE_LIMIT_PER_MINUTE=60

# Optional: use an installed Chrome instead of downloading Playwright Chromium
# PLAYWRIGHT_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
