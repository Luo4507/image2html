# 通用模型配置
LLM_VL_BASE_URL=http://vision-model.internal:8000/v1
LLM_VL_API_KEY=your-api-key-here
LLM_VL_MODEL=your-vision-model-name

LLM_BASE_URL=http://code-model.internal:8001/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-code-model-name

# Optional provider thinking overrides (unset preserves provider defaults)
# LLM_VL_ENABLE_THINKING=false
# LLM_ENABLE_THINKING=false

# 校验配置（默认质量优先）
VISUAL_SIMILARITY_THRESHOLD=85.0
MIN_CONTENT_SIMILARITY=60.0
MIN_EDGE_SIMILARITY=40.0
CHECK_TEXT_COVERAGE=true
MIN_TEXT_COVERAGE=80.0
MAX_RETRY_COUNT=4

# 默认选项
DEFAULT_FRAMEWORK=react
DEFAULT_STYLE_FRAMEWORK=tailwind
DEFAULT_COMPONENT_LIBRARY=antd

# direct: one multimodal call; structured: optional JSON expert pipeline
DEFAULT_PIPELINE=direct
# fast: no auto repair; balanced: up to 2 repairs; precision: up to 4 repairs
QUALITY_MODE=precision
# single: default; segmented: force regions; auto: segment only tall screenshots
DEFAULT_LAYOUT_MODE=single

# Optional local performance controls (safe defaults: cache off, bounded regions)
# CONVERSION_CACHE=false
# CONVERSION_CACHE_DIR=.cache/image2html-conversions
# REGION_CONCURRENCY=3

# Multi-user HTTP server
# Required for pnpm serve / Docker. Use a unique long random secret per user.
API_KEYS=alice:replace-with-a-long-random-secret,bob:replace-with-another-secret
HOST=0.0.0.0
PORT=3000
DATA_DIR=data
MAX_UPLOAD_MB=10
JOB_CONCURRENCY=2
MAX_QUEUE_SIZE=100
RATE_LIMIT_PER_MINUTE=60

# Optional: use an installed Chrome instead of downloading Playwright Chromium
# PLAYWRIGHT_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Remote MCP stdio adapter (configure on each user's machine)
# IMAGE2HTML_URL=https://image2html.internal.example
# IMAGE2HTML_API_KEY=replace-with-personal-key
# IMAGE2HTML_POLL_INTERVAL_MS=1000
# IMAGE2HTML_TIMEOUT_MS=600000
